# Copy to provision.env on the VM, fill in, `set -a; source provision.env; set +a`,
# then run ./provision.sh. Never commit the filled-in copy.

# vh-db superuser connection
PGHOST=vh-db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# Application role passwords. For production these must match the values already
# in each service's .env — the .env files are copied over from the current VMs
# unchanged, so the passwords are dictated by them, not chosen here.
ORDERS_PW=
EVENTS_PW=
PROFILE_PW=
ACCOUNTING_PW=

# Redash read-only role
REDASH_PW=
