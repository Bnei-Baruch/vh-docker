# Copy to provision.env beside this file, fill in, then run as root on the vh-db host:
#
#   cd /root/vh-docker/db/provision && ./provision.sh production
#
# The script reads this file itself — do NOT source it. Values are taken
# verbatim, so passwords need no quoting or escaping whatever they contain.
# The filled-in copy is gitignored; never commit it.
#
# There is no connection section: psql always runs via `sudo -u postgres` on the
# local socket. Ambient PGHOST/PGUSER on the host cannot interfere, because sudo
# resets the environment.

# Application role passwords. The script re-applies these on every run, so a
# wrong value here overwrites a working credential. They must match what the
# service .env files already carry — for production, copy them out of the
# captured production .env files (DB_PASSWORD, or PGPASSWORD for accounting).
ORDERS_PW=
EVENTS_PW=
PROFILE_PW=
ACCOUNTING_PW=

# Redash read-only role (`redash_readonly`). Set to the password Redash is
# already configured with — this script creates the role, it does not choose
# the credential.
REDASH_PW=
