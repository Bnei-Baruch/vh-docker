# Host-level secrets for /root/vh-docker/.env — hand-created on the VM, never in git.
# This is infrastructure only; each application's own secrets live in
# apps/<service>/.env next to its compose file.

# --- GitHub Container Registry (image pulls) ---
GHCR_USER=
GHCR_TOKEN=

# --- NATS (nats/nats.yml) ---
# Must match NATS_URL in the backends' own .env files.
NATS_USER=
NATS_PASSWORD=

# --- Loki remote write (production only, monitoring/config/grafana.river.tmpl) ---
LOKI_USER=loki
LOKI_PASSWORD=
